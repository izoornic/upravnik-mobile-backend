          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"r_date\": \"2026-02-18\",\n  \"r_iznos\": 5000.00\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/stan-zaduzenja/{{smz_id}}/uplata",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "stan-zaduzenja", "{{smz_id}}", "uplata"]
            },
            "description": "Records a payment on a unit monthly charge. Set smz_id to the stan_mesec_zaduzenje ID."
          }
        }
      ]
    },
